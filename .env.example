# =====================================================
# BATT-X environment variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to source control.
# =====================================================

# Environment
NODE_ENV=production

# Database (PostgreSQL)
# Replace with your production database connection string
# Current production: Neon PostgreSQL
# Get from: Neon Console -> your database -> Connection String
DATABASE_URL="postgresql://user:password@ep-xxx-xxx.region.aws.neon.tech/battx?sslmode=require"

# NextAuth (Authentication)
# Generate with: openssl rand -base64 32
# CRITICAL: Must be a strong random secret (32+ bytes)
NEXTAUTH_SECRET="REPLACE_WITH_32_BYTE_RANDOM_BASE64"

# NextAuth URL (Your production domain)
# Current production: Vercel deployment
# Example: https://batt-x.vercel.app
NEXTAUTH_URL="https://your-app.vercel.app"

# Auth Trust Host (Set to true for production behind proxy)
AUTH_TRUST_HOST=true

# Auth URL (Same as NEXTAUTH_URL - for NextAuth v5 compatibility)
AUTH_URL="https://your-app.vercel.app"

# IoT Device Ingest Secret
# Generate with: openssl rand -base64 32
# ESP32 devices must send this in X-Device-Key header when posting sensor data
# CRITICAL: Keep this secret, it authenticates all ESP32 devices
# IMPORTANT: Copy this EXACT value to your ESP32 firmware configuration
DEVICE_INGEST_SECRET="REPLACE_WITH_32_BYTE_RANDOM_BASE64"

# Socket.io Configuration
# Port for Socket.io server (must be accessible from clients)
SOCKET_PORT=3001

# Socket.io Public URL (accessible from browser clients)
# Current production: Render deployment for Socket.IO server
# Example: https://battx-socket.onrender.com or wss://battx-socket.onrender.com
NEXT_PUBLIC_SOCKET_URL="https://your-socket-server.onrender.com"

# Socket Demo Mode (Set to false in production)
# When true, generates simulated sensor data for demo-device-1
# When false, only accepts real ESP32 sensor data
# PRODUCTION: MUST be false
SOCKET_DEMO_MODE=false
